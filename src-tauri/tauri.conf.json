{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nt-usb-plus-on-linux",
  "mainBinaryName": "nt-usb-plus-on-linux",
  "version": "0.1.0",
  "identifier": "de.marvingazibaric.nt-usb-plus-on-linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "NT-USB+ Control",
        "width": 1080,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "publisher": "Marvin Gazibarić",
    "homepage": "https://github.com/mgazibaric/nt-usb-plus-on-linux",
    "shortDescription": "Control panel for the RØDE NT-USB+",
    "longDescription": "Settings and audio processing of the RØDE NT-USB+ microphone: input level, high-pass filter, direct monitoring, noise gate, compressor, Aural Exciter and Big Bottom. Unofficial, not affiliated with RØDE.",
    "linux": {
      "deb": {
        "section": "sound",
        "depends": ["libasound2"],
        "recommends": ["pipewire-bin | alsa-utils"],
        "desktopTemplate": "../packaging/nt-usb-plus-on-linux.desktop",
        "files": {
          "/usr/lib/udev/rules.d/70-rode-nt-usb-plus.rules": "../udev/70-rode-nt-usb-plus.rules"
        },
        "postInstallScript": "../packaging/udev-reload.sh"
      },
      "rpm": {
        "depends": ["alsa-lib"],
        "recommends": ["pipewire-utils"],
        "desktopTemplate": "../packaging/nt-usb-plus-on-linux.desktop",
        "files": {
          "/usr/lib/udev/rules.d/70-rode-nt-usb-plus.rules": "../udev/70-rode-nt-usb-plus.rules"
        },
        "postInstallScript": "../packaging/udev-reload.sh"
      }
    }
  }
}
